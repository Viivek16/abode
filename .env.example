NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only, used by the seed script + Sheet->app pull
ADMIN_EMAIL=                    # the only address allowed to sign in

# Google Sheets two-way sync (server only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=   # abode-sync@<project>.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=             # "-----BEGIN PRIVATE KEY-----\n...\n-----END...\n" (quoted)
GOOGLE_SHEET_ID=                # the id from the sheet URL
SHEET_SYNC_SECRET=              # shared secret for the Apps Script -> /api/sheet/pull webhook
